<?xml version="1.0"?>
<!DOCTYPE service_bundle SYSTEM "/usr/share/lib/xml/dtd/service_bundle.dtd.1">
<!--
	This Source Code Form is subject to the terms of the Mozilla Public
	License, v. 2.0. If a copy of the MPL was not distributed with this
	file, You can obtain one at https://mozilla.org/MPL/2.0/.

	NOTE: This service manifest is delivered by package/pkg6/depotd and
	is overwritten on upgrade. Customize the service with svccfg, not
	by editing this file.
-->
<service_bundle type='manifest' name='pkg6/depotd:pkg6depotd'>

<service name='application/pkg/pkg6depotd' type='service' version='1'>

	<!--
	    Disabled until the operator has created a repository and reviewed
	    /etc/pkg6depotd/pkg6depotd.kdl.
	-->
	<create_default_instance enabled='false' />

	<dependency name='fs-local' grouping='require_all' restart_on='none'
	    type='service'>
		<service_fmri value='svc:/system/filesystem/local' />
	</dependency>

	<dependency name='network' grouping='require_all' restart_on='none'
	    type='service'>
		<service_fmri value='svc:/milestone/network' />
	</dependency>

	<exec_method type='method' name='start'
	    exec='/lib/svc/method/svc-pkg6depotd start' timeout_seconds='60'>
		<method_context>
			<method_credential user='pkg6srv' group='pkg6srv'
			    privileges='basic,!file_link_any,!proc_info,!proc_session,net_privaddr' />
		</method_context>
	</exec_method>

	<exec_method type='method' name='stop' exec=':kill'
	    timeout_seconds='60' />

	<!--
	    SIGHUP re-reads the TLS certificate and key; a bad file is logged
	    and the current certificate stays in service. Other configuration
	    changes need a restart.
	-->
	<exec_method type='method' name='refresh' exec=':kill -HUP'
	    timeout_seconds='60' />

	<property_group name='startd' type='framework'>
		<!-- pkg6depotd always runs in the foreground. -->
		<propval name='duration' type='astring' value='child' />
	</property_group>

	<property_group name='config' type='application'>
		<!-- KDL configuration file for this instance. -->
		<propval name='file' type='astring'
		    value='/etc/pkg6depotd/pkg6depotd.kdl' />
		<!-- RUST_LOG filter; empty uses the built-in default. -->
		<propval name='log_filter' type='astring' value='' />
	</property_group>

	<stability value='Unstable' />

	<template>
		<common_name>
			<loctext xml:lang='C'>pkg6 IPS repository depot server</loctext>
		</common_name>
		<description>
			<loctext xml:lang='C'>Serves IPS package repositories to pkg(1) clients over the pkg5 depot protocol.</loctext>
		</description>
		<documentation>
			<doc_link name='ips'
			    uri='https://code.aopc.cloud/OpenIndiana/ips' />
		</documentation>
		<pg_pattern name='config' type='application' target='this'
		    required='false'>
			<prop_pattern name='file' type='astring' required='false'>
				<description>
					<loctext xml:lang='C'>Path of the KDL configuration file.</loctext>
				</description>
				<cardinality min='1' max='1' />
			</prop_pattern>
			<prop_pattern name='log_filter' type='astring'
			    required='false'>
				<description>
					<loctext xml:lang='C'>RUST_LOG directive for the daemon, for example info or pkg6depotd=debug.</loctext>
				</description>
				<cardinality min='0' max='1' />
			</prop_pattern>
		</pg_pattern>
	</template>
</service>

</service_bundle>
