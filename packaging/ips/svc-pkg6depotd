#
# SMF method for svc:/application/pkg/pkg6depotd. The daemon stays in the
# foreground (startd/duration=child); SMF stops it with :kill.

# shellcheck disable=SC1091
. /lib/svc/share/smf_include.sh

DEPOTD=/usr/lib/pkg6depotd
DEFAULT_CONFIG=/etc/pkg6depotd/pkg6depotd.kdl

getprop() {
	val=$(/usr/bin/svcprop -p "$1" "$SMF_FMRI" 2>/dev/null)
	# svcprop prints "" for an empty astring
	[ "$val" = '""' ] && val=
	echo "$val"
}

case "$1" in
start)
	config=$(getprop config/file)
	[ -n "$config" ] || config=$DEFAULT_CONFIG

	# pkg6depotd itself refuses a missing configuration; checking here as
	# well reports SMF_EXIT_ERR_CONFIG with a clear log line.
	if [ ! -r "$config" ]; then
		echo "pkg6depotd: configuration $config is missing or" \
		    "unreadable by $(/usr/bin/id -un)"
		exit "$SMF_EXIT_ERR_CONFIG"
	fi

	log_filter=$(getprop config/log_filter)
	if [ -n "$log_filter" ]; then
		RUST_LOG=$log_filter
		export RUST_LOG
	fi

	# With duration=child SMF marks the service online as soon as this
	# method execs the daemon, before it parses the file. Validate first,
	# as the same user and with the same file, so a readable but invalid
	# configuration fails the start method and the instance goes to
	# maintenance instead of restarting in a loop. config-test prints only
	# a fixed summary (no credentials) and makes no ACME requests.
	if ! $DEPOTD --config "$config" config-test; then
		echo "pkg6depotd: configuration $config is invalid; fix it," \
		    "check it with '$DEPOTD --config $config config-test'," \
		    "then run 'svcadm clear $SMF_FMRI'"
		exit "$SMF_EXIT_ERR_CONFIG"
	fi

	exec $DEPOTD --config "$config" start
	;;
*)
	echo "Usage: $0 start"
	exit "$SMF_EXIT_ERR_FATAL"
	;;
esac
